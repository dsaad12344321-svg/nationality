      ],
      "bookingIdentifiers": [
        "Res.No"
      ],
      "guestFields": [
        "name",
        "dateOfBirth"
      ]
    },
    {
      "id": "mts",
      "company": "MTS",
      "aliases": [
        "MTS"
      ],
      "parser": "generic",
      "signatures": [],
      "bookingIdentifiers": [
        "booking number",
        "confirmation number"
      ],
      "guestFields": [
        "name",
        "dateOfBirth"
      ]
    }
  ]
}
