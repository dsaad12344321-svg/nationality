        "FUN &SUN",
        "Hotel2Sejour"
      ],
      "parser": "funsun",
      "signatures": [
        "FUN\\s*&\\s*SUN",
        "FUN\\s+SUN",
        "EX\\s+TUI\\s+RUSSIA",
        "Passenger\\s+Informations",
        "Surname,\\s*Name",
        "Birthdate"
      ],
      "bookingIdentifiers": [
        "numeric PDF filename",
        "voucher number"
      ],
      "guestFields": [
        "name",
        "dateOfBirth"
      ]
    },
    {
      "id": "sun",
      "company": "SUN International",
      "aliases": [
        "SUN",
        "SUN International",
        "Hotel2Sejour"
      ],
      "parser": "sun",
      "signatures": [
        "passenger\\s+informations",
        "surname\\s*,?\\s*name",
        "\\bbirthdate\\b",
        "\\btitle\\b",
        "\\bage\\b"
      ],
      "bookingIdentifiers": [
        "voucher reference"
      ],
      "guestFields": [
        "name",
        "dateOfBirth"
      ]
    },
    {
      "id": "odeon",
      "company": "Odeon",
      "aliases": [
        "Odeon"
      ],
      "parser": "odeon",
      "signatures": [
        "\\b(?:voucher\\s*no|operator\\s+voucher\\s+no)\\b",
        "\\btourists\\b"
      ],
      "bookingIdentifiers": [
        "Voucher No",
        "Operator Voucher No"
      ],
      "guestFields": [
        "name",
        "dateOfBirth"
      ]
    },
    {
      "id": "pegas",
      "company": "Pegas",
      "aliases": [
        "Pegas",
        "Pegas Touristik"
      ],
      "parser": "pegas",
      "signatures": [
        "\\blast\\s+name\\b",
        "\\bfirst\\s+name\\b",
        "\\bdate\\s+of\\s+birth\\b"
      ],
      "bookingIdentifiers": [
        "voucher reference"
      ],
      "guestFields": [
        "name",
        "dateOfBirth"
      ]
    },
    {
      "id": "anex",
      "company": "Anex",
      "aliases": [
        "Anex",
        "Anex Tour"
      ],
      "parser": "anex",
      "signatures": [
        "\\bclients\\s*names\\s*,?\\s*citizenship\\b",
